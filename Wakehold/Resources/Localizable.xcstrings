    "Set up…" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إعداد…"
          }
        }
      }
    },
    "Settings…" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإعدادات…"
          }
        }
      }
    },
    "Setup" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإعداد"
          }
        }
      }
    },
    "Setup asks for an admin password once. A closed Mac in a bag can run hot; the battery rules still apply." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يطلب الإعداد كلمة سر المسؤول مرة واحدة. قد يسخن الماك المغلق داخل حقيبة؛ وتبقى قواعد البطارية سارية."
          }
        }
      }
    },
    "Setup did not finish." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يكتمل الإعداد."
          }
        }
      }
    },
    "Show what is holding" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عرض ما يُبقيه مستيقظًا"
          }
        }
      }
    },
    "Sleeps as usual" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينام كالمعتاد"
          }
        }
      }
    },
    "Socket" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المقبس"
          }
        }
      }
    },
    "Source code" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الشيفرة المصدرية"
          }
        }
      }
    },
    "Starts the default duration, or turns off the running one." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبدأ المدة الافتراضية، أو يوقف المدة الجارية."
          }
        }
      }
    },
    "Startup" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدء التشغيل"
          }
        }
      }
    },
    "Status" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحالة"
          }
        }
      }
    },
    "Stay awake with the lid closed" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "البقاء مستيقظًا والغطاء مغلق"
          }
        }
      }
    },
    "Stays awake" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبقى مستيقظًا"
          }
        }
      }
    },
    "Stays awake with the lid closed" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبقى مستيقظًا والغطاء مغلق"
          }
        }
      }
    },
    "The menu bar, the wakehold command, and any agent or script all open sessions through the same local endpoint." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شريط القوائم وأمر wakehold وأي وكيل أو سكربت، جميعها تفتح الجلسات عبر نقطة التحكم المحلية نفسها."
          }
        }
      }
    },
    "These appear in the menu." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر هذه في القائمة."
          }
        }
      }
    },
    "Toggle shortcut" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختصار التبديل"
          }
        }
      }
    },
    "Turn off" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إيقاف"
          }
        }
      }
    },
    "Version %@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإصدار %@"
          }
        }
      }
    },
    "Wakehold keeps your Mac awake for exactly as long as your work is alive, then lets it sleep. A timer, a running process, a listening port, a wrapped command, an agent session, or an open app: each one is a session that holds the Mac awake. When the last session ends, the hold releases on its own." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُبقي Wakehold جهاز الماك مستيقظًا ما دام عملك قائمًا بالضبط، ثم يتركه ينام. المؤقت، والعملية الجارية، والمنفذ المستمع، والأمر المُغلَّف، وجلسة الوكيل، والتطبيق المفتوح: كل منها جلسة تُبقي الماك مستيقظًا. وحين تنتهي آخر جلسة، يُفلت الإبقاء من تلقاء نفسه."
          }
        }
      }
    },
    "When last session ends" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند انتهاء آخر جلسة"
          }
        }
      }
    },
    "While an app runs" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أثناء تشغيل تطبيق"
          }
        }
      }
    }
  },
  "version" : "1.1"
}