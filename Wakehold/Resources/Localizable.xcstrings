    "A click on the eye, the toggle shortcut, and activate on launch use the default." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النقر على العين واختصار التبديل والتفعيل عند التشغيل تستخدم المدة الافتراضية."
          }
        }
      }
    },
    "A rule pauses the hold without ending sessions; the hold resumes when the rule clears." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توقف القاعدة الإبقاء مؤقتًا دون إنهاء الجلسات، ويُستأنف الإبقاء حين تزول."
          }
        }
      }
    },
    "A Unix socket readable only by you. Scripts can open sessions with curl --unix-socket." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مقبس Unix لا يقرؤه أحد غيرك. يمكن للسكربتات فتح الجلسات عبر curl --unix-socket."
          }
        }
      }
    },
